APP_NAME=billing-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8084

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=billing-db
DB_PORT=3306
DB_DATABASE=billing
DB_USERNAME=billing
DB_PASSWORD=billing

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

AWS_DEFAULT_REGION=us-east-1
# LocalStack (docker-compose). Em EKS deixe vazio: SDK usa endpoint real + LabRole.
AWS_ENDPOINT_URL=http://localstack:4566
MESSAGING_DRIVER=sqs
MESSAGING_QUEUE_PREFIX=local

# URL pública (API Gateway) para links de aprovação e notification_url do MP
BILLING_PUBLIC_URL=http://localhost:8084

# fake (demonstração local) | mercadopago (sandbox/produção)
PAYMENT_GATEWAY=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true

# Mesmo JWT_SECRET do os-service (valida o token de funcionário)
JWT_SECRET=

NEWRELIC_LICENSE_KEY=
NEWRELIC_APPNAME=billing-service
